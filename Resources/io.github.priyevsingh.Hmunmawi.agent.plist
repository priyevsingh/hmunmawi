<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.priyevsingh.Hmunmawi.agent</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/Hmunmawi</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>io.github.priyevsingh.Hmunmawi</string>
    </array>
    <!-- Start at login, and relaunch only if it crashed (quitting normally exits with 0 and stays quit). -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
</dict>
</plist>
