<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.priyevsingh.Hmunmawi.keychain-watch</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HM_APP_ROOT__/Contents/Helpers/keychain-prompt-watch.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/hmunmawi-keychain-watch.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/hmunmawi-keychain-watch.log</string>
</dict>
</plist>
